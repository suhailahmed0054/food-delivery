{
  "name": "al-arab-restaurant",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "verify": "npm run lint && npm run typecheck && npm run build && npm audit --audit-level=high",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "release:check": "node scripts/release-check.mjs",
    "android:add": "npm run android:add -w apps/web",
    "android:sync": "npm run android:sync -w apps/web",
    "android:dev": "npm run android:dev -w apps/web",
    "android:build": "npm run android:build -w apps/web",
    "android:open": "npm run android:open -w apps/web"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "postcss": "8.5.23"
  },
  "dependencies": {
    "framer-motion": "^12.42.0",
    "leaflet": "^1.9.4",
    "next": "15.5.21",
    "react-leaflet": "^5.0.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.7"
    },
    "js-yaml": "4.3.0",
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.0"
    },
    "tar": "7.5.21"
  }
}
