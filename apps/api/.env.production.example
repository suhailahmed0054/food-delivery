NODE_ENV=production
PORT=5000
CLIENT_URL=https://order.example.com
MONGODB_URI=
REDIS_URL=rediss://replace-with-production-redis-connection-string
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
